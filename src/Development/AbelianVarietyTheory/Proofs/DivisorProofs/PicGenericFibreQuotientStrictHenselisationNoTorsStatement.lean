  have hs : s * ((n + 1 : ℕ) : B) = 1 := hq.val_inv_mul
  set Eh : Multiplicative (ZMod (n + 1)) → Alg φ ⊗[B] Alg φ :=
    fun h => E φ c s (tw ζ (-h.toAdd)) with hEh
