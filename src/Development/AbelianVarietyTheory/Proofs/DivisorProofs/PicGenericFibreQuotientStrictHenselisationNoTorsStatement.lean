            simp only [ψ, hab]
        _ = ∑ h, (a ⊗ₜ[B] (1 : Alg φ)) * (Eh h * (act φ ζ hζ h b ⊗ₜ[B] (1 : Alg φ))) := by
            refine Finset.sum_congr rfl fun h _ => ?_
            rw [← mul_one (1 : Alg φ), ← Algebra.TensorProduct.tmul_mul_tmul]; ring_nf
