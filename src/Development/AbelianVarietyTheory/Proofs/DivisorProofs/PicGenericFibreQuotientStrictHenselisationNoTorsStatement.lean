            simp only [hEb]
        _ = (a ⊗ₜ[B] (1 : Alg φ)) * ((1 : Alg φ) ⊗ₜ[B] b) * ∑ h, Eh h := by
            rw [Finset.mul_sum]; refine Finset.sum_congr rfl fun h _ => ?_; ring
        _ = a ⊗ₜ b := by rw [hsum, mul_one, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
