  · intro d
    funext g
    rw [hΦev]

    simp only [ψ, map_sum, map_mul, ev_tmul, map_one, mul_one, hEh,
    ev_E φ c hc s hs ζ hζ hk, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ,
