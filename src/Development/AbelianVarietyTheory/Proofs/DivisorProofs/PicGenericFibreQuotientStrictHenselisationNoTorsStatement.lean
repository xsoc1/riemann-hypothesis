    (hs : s * ((n + 1 : ℕ) : B) = 1) (ζ : B) (hζ : ζ ^ (n + 1) = 1)
    (hk : ∀ k : ℕ, 0 < k → k < n + 1 → IsUnit (1 - ζ ^ k)) :
