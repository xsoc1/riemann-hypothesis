        (fun g => (GlobalTheory.KummerAlg.act φ ζ hζ g).toAlgHom))) := by
  intro B _ L _ _ _ q _ φ hq hφ ζ hζ hk
  obtain ⟨n, rfl⟩ : ∃ n, q = n + 1 := ⟨q - 1, (Nat.succ_pred_eq_of_pos (NeZero.pos q)).symm⟩
